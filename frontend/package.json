{
    "name": "wannarun-frontend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "dev:api": "uv run --project .. python -m uvicorn backend.dev:app --app-dir .. --host 127.0.0.1 --port 8000",
        "typecheck": "tsc --noEmit",
        "test:tracking": "node --experimental-strip-types --test tests/tracking.test.ts",
        "test:territory": "node --experimental-strip-types --test tests/territory.test.ts",
        "android:sync": "npm run build && cap sync android",
        "android:open": "cap open android"
    },
    "dependencies": {
        "@capacitor-community/background-geolocation": "^1.3.1",
        "@capacitor/android": "^7.6.10",
        "@capacitor/core": "^7.6.10",
        "@capacitor/local-notifications": "^7.0.7",
        "@fontsource/barlow-condensed": "^5.3.0",
        "@vitejs/plugin-react": "^4.3.4",
        "leaflet": "^1.9.4",
        "leaflet.markercluster": "^1.5.3",
        "lucide-react": "^1.70.0",
        "pretendard": "^1.3.9",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-leaflet": "^4.2.1",
        "typescript": "^5.7.2",
        "vite": "^5.4.14"
    },
    "devDependencies": {
        "@capacitor/cli": "^7.6.10",
        "@types/leaflet": "^1.9.22",
        "@types/leaflet.markercluster": "^1.5.6",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7"
    }
}
